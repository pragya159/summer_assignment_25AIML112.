#include<stdio.h>
int main() {
    int num;
    printf("Enter a number: ");
    scanf("%d", &num);
    
    for(int i = 1; i <= 10; i++) {
        printf("%d x %d = %d\n", num, i, num*i);
    }
    return 0;
}




"que 3"
#include<stdio.h>
int main() {
    int n;
    long long fact = 1;
    printf("Enter a number: ");
    scanf("%d", &n);
    
    for(int i = 1; i <= n; i++) {
        fact *= i;
    }
    printf("Factorial = %lld\n", fact);
    return 0;
}




"que 4"
#include<stdio.h>
int main() {
    int n, count = 0;
    printf("Enter a number: ");
    scanf("%d", &n);
    
    if(n == 0) {
        count = 1;
    } else {
        while(n != 0) {
            n /= 10;
            count++;
        }
    }
    printf("Number of digits = %d\n", count);
    return 0;
}
